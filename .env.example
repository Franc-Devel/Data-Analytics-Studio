# ===================================================
# Nexo Analytics - Variables de Entorno (Plantilla)
# ===================================================
# Copie este archivo como '.env' y configure los valores según su entorno.

# Entorno de la Aplicación: development | testing | production
APP_ENV=development

# Claves Criptográficas y Seguridad de la Aplicación
# Genere cadenas seguras de 32 bytes con: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=generate_random_secret_key_here
# Clave Fernet / AES-256 base64 urlsafe (32 bytes base64) para cifrado de campos y backups
# Genere con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=
# Clave HMAC para índice ciego (Blind Index) de búsqueda sin descifrar
BLIND_INDEX_KEY=
# Clave de cifrado de backups (puede ser igual a APP_ENCRYPTION_KEY o una frase de paso fuerte)
BACKUP_ENCRYPTION_KEY=

# Control de Inicialización y Autenticación
# AUTH_ENABLED=false permite acceso directo al dashboard sin solicitar login/2FA
AUTH_ENABLED=false
# En producción DEBE permanecer en false para evitar siembra insegura
AUTO_SEED_DEFAULT_USERS=false

# Base de Datos Relacional (PostgreSQL con TLS en producción o SQLite local en desarrollo)
# Ej. PostgreSQL: postgresql://crm_user:secure_pwd@db.internal:5432/consultora_crm?sslmode=verify-full
# Ej. SQLite: sqlite:///data/consultora_crm.db
DATABASE_URL=sqlite:///data/consultora_crm.db

# Rutas de Archivos de Datos (Excel)
# En desarrollo puede apuntar a los archivos de muestra en data/
LEADS_EXCEL_PATH=Leeds orden.xlsx
COMMERCIAL_EXCEL_PATH=Comercial.xlsx

# Configuración y Autenticación del Puente WhatsApp (Node.js / Baileys)
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3001
# Token de servicio fuerte requerido para autorizar cualquier petición al bridge
WHATSAPP_BRIDGE_TOKEN=generate_strong_random_token_for_bridge
WHATSAPP_CONFIG_PATH=whatsapp_config.json
WHATSAPP_INBOX_DIR=whatsapp_inbox
WHATSAPP_SYNC_STATE_PATH=whatsapp_sync_state.json

# Meta Cloud API / Evolution API (Opcional si usa APIs oficiales o Gateway)
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_VERIFY_TOKEN=
WHATSAPP_GATEWAY_API_KEY=

# Sistema de Logging
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE_NAME=app.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# Política de Backups y Recuperación
BACKUP_DIR=backups
AUTO_BACKUP_ENABLED=true
MAX_BACKUPS_RETAINED=20
BACKUP_ENCRYPTION_ENABLED=true

# Inteligencia Artificial (API LLM compatible OpenAI / REST)
LLM_ENABLED=true
OPENAI_API_KEY=su_clave_api_aqui
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30


